# ==============================================================================
# SeatSync AI - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual private values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Database & Cache Credentials
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380

# ------------------------------------------------------------------------------
# 3. Application Security (JWT Secret)
# In production, generate a secure 256-bit hexadecimal key
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_random_64_character_hex_secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. Networking & Ports
# ------------------------------------------------------------------------------
BACKEND_PORT=8081
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

